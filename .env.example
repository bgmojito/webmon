# Copiez ce fichier vers .env puis adaptez les valeurs si besoin :
#   cp .env.example .env
#
# .env n'est jamais commite (voir .gitignore). Les valeurs ci-dessous sont
# des valeurs de demo qui permettent de demarrer la stack en une commande
# (`make start` / `docker compose up -d`) ; changez-les avant tout usage
# au-dela d'une machine de developpement locale.

# Mot de passe de l'utilisateur PostgreSQL "webmon" (postgres, backend).
POSTGRES_PASSWORD=webmon_pwd

# Mot de passe du compte admin Grafana (utilisateur : admin).
GF_SECURITY_ADMIN_PASSWORD=admin

# Chaine de connexion utilisee par postgres-exporter pour scraper PostgreSQL.
# Doit rester coherente avec POSTGRES_PASSWORD ci-dessus.
DATA_SOURCE_NAME=postgresql://webmon:webmon_pwd@postgres:5432/webmon?sslmode=disable

# Hote affiche par le Makefile (make start, make chaos, make stress) pour
# l'URL de l'app publique (nginx). Le Makefile charge ce fichier .env
# automatiquement ; sans .env ou sans cette variable, il retombe sur
# "localhost". Sans effet sur docker-compose.yml : uniquement un
# confort d'affichage pour les scripts.
# HOST_IP=localhost
